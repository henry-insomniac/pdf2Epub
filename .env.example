BTC_USERNAME=admin
BTC_PASSWORD=change-this-password
BTC_SESSION_SECRET=replace-with-at-least-32-random-bytes
BTC_BIND_IP=127.0.0.1
BTC_PORT=8080
# 直接使用 HTTP 测试时设为 false；放到 HTTPS 反向代理后必须设为 true。
BTC_SECURE_COOKIE=false
BTC_FIXED_LAYOUT_DPI=144
BTC_MAX_UPLOAD_MIB=

# 公开额度模式。默认推荐 voucher + altcha，无需 Stripe 或 Turnstile 账号。
BTC_PUBLIC_ACCESS=false
BTC_PUBLIC_URL=https://epub.yi-flow.com
BTC_QUEUE_CAPACITY=3
BTC_CREDIT_PACK_CREDITS=5
BTC_CREDIT_PACK_LABEL=5 次额度
BTC_PAYMENT_PROVIDER=voucher
# 使用 openssl rand -hex 32 生成；更换后旧额度码将无法验证或恢复钱包。
BTC_VOUCHER_SECRET=
# 可选值：voucher、stripe。Stripe 模式才需要下面三个变量。
BTC_STRIPE_SECRET_KEY=
BTC_STRIPE_WEBHOOK_SECRET=
BTC_STRIPE_PRICE_ID=
BTC_CHALLENGE_PROVIDER=altcha
# 可选值：altcha、turnstile。Turnstile 模式才需要下面两个变量。
BTC_TURNSTILE_SITE_KEY=
BTC_TURNSTILE_SECRET_KEY=

# 公开模式必须使用私有 R2 bucket；下载由短时签名 URL 承担，不占源站带宽。
BTC_R2_ACCOUNT_ID=
BTC_R2_ACCESS_KEY_ID=
BTC_R2_SECRET_ACCESS_KEY=
BTC_R2_BUCKET=
BTC_R2_PREFIX=epub
BTC_DOWNLOAD_URL_TTL=15m
